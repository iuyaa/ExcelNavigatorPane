<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Excel Navigator $(var.ReleaseVersion) payload" Manufacturer="Excel Navigator" Version="$(var.MsiVersion)"
           UpgradeCode="4BCB8A50-9302-4E53-8829-F103215C070E" Scope="perMachine" Language="2052" Codepage="65001">
    <!-- Only migrate the old flat layout. Versioned payloads coexist until explicit uninstall. -->
    <Upgrade Id="A14219F5-2541-441C-BAEC-606015D32B55">
      <UpgradeVersion Minimum="1.0.0" IncludeMinimum="yes" Property="LEGACY_PRODUCTS" />
    </Upgrade>
    <Upgrade Id="4BCB8A50-9302-4E53-8829-F103215C070E">
      <UpgradeVersion Minimum="$(var.MsiVersion)" IncludeMinimum="no" OnlyDetect="yes" Property="NEWER_PAYLOAD" />
    </Upgrade>
    <InstallExecuteSequence><RemoveExistingProducts After="InstallInitialize" /></InstallExecuteSequence>
    <Launch Condition="Installed OR NOT NEWER_PAYLOAD" Message="已安装更高版本，请使用 EXE 的恢复功能。" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <Property Id="EXCELNAV_SETUP" Secure="yes" />
    <Launch Condition="EXCELNAV_SETUP = 1" Message="这是版本载荷包，请运行 ExcelNavigator-Setup EXE 完成安装或维护。" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <?if $(sys.BUILDARCH) = x86 ?>
    <Launch Condition="Installed OR NOT VersionNT64" Message="64 位 Windows 请运行 EXE 或 x64 MSI；它同时支持 32 位和 64 位 Excel/WPS。" />
    <?endif ?>
    <Property Id="NET48">
      <RegistrySearch Id="Net48Search" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="VSTORUNTIME">
      <RegistrySearch Id="VstoRedistributable32" Root="HKLM" Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4R" Name="Version" Type="raw" Bitness="always32" />
      <RegistrySearch Id="VstoOffice32" Root="HKLM" Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4" Name="Version" Type="raw" Bitness="always32" />
      <RegistrySearch Id="VstoRedistributable64" Root="HKLM" Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4R" Name="Version" Type="raw" Bitness="always64" />
      <RegistrySearch Id="VstoOffice64" Root="HKLM" Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4" Name="Version" Type="raw" Bitness="always64" />
    </Property>
    <!-- ponytail: raw DWORDs compare as strings; .NET 4.x Release values have six digits. -->
    <Launch Condition="Installed OR (NET48 &gt;= &quot;#528040&quot;)" Message="请先安装 .NET Framework 4.8，或运行 EXE 安装包自动安装依赖。" />
    <Launch Condition="Installed OR VSTORUNTIME" Message="请先安装 VSTO Runtime，或运行 EXE 安装包自动安装依赖。" />
    <StandardDirectory Id="$(var.ProgramFiles)">
      <Directory Id="INSTALLFOLDER" Name="ExcelNavigatorPane">
        <Directory Id="VERSIONSFOLDER" Name="Versions">
          <Directory Id="VERSIONFOLDER" Name="$(var.ReleaseVersion)">
            <?include $(var.PayloadInclude) ?>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Excel Navigator" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
    </Feature>
  </Package>
</Wix>
